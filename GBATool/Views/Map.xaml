<UserControl x:Class="GBATool.Views.Map"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GBATool.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:GBATool.Utils.Behaviors"
             xmlns:fx="clr-namespace:ArchitectureLibrary.FXs;assembly=ArchitectureLibrary"
			 xmlns:ex="clr-namespace:ArchitectureLibrary.WPF.Extensions;assembly=ArchitectureLibrary"
             xmlns:uc="clr-namespace:GBATool.Views"
             xmlns:vm="clr-namespace:GBATool.ViewModels"
             xmlns:cv="clr-namespace:ArchitectureLibrary.WPF.Converters;assembly=ArchitectureLibrary"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             Name="MapView"
             mc:Ignorable="d" 
             d:DesignHeight="890" d:DesignWidth="1300">
    <UserControl.DataContext>
        <vm:MapViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <cv:EnumMatchToBooleanConverter x:Key="enumConverter" />
        <cv:WidthConverter x:Key="widthConverter" />
		<x:Array x:Key="PaletteIndices" Type="system:Int32">
			<system:Int32>0</system:Int32>
			<system:Int32>1</system:Int32>
			<system:Int32>2</system:Int32>
			<system:Int32>3</system:Int32>
			<system:Int32>4</system:Int32>
			<system:Int32>5</system:Int32>
			<system:Int32>6</system:Int32>
			<system:Int32>7</system:Int32>
			<system:Int32>8</system:Int32>
			<system:Int32>9</system:Int32>
			<system:Int32>10</system:Int32>
			<system:Int32>11</system:Int32>
			<system:Int32>12</system:Int32>
			<system:Int32>13</system:Int32>
			<system:Int32>14</system:Int32>
			<system:Int32>15</system:Int32>
		</x:Array>
    </UserControl.Resources>
    <Grid Background="LightGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="800"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="1">
                <Canvas Width="{Binding CanvasWidth}" 
                        Height="{Binding CanvasHeight}" 
                        x:Name="mapCanvas"
						RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Background="DarkGray"
                        MouseEnter="MapCanvas_MouseEnter" 
						MouseLeave="MapCanvas_MouseLeave"
						MouseMove="MapCanvas_MouseMove" 
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
					<i:Interaction.Behaviors>
						<behaviors:EventToCommandBehavior Command="{Binding MouseMoveEventCommand}" Event="MouseMove" PassArguments="True" />
						<behaviors:EventToCommandBehavior Command="{Binding MouseDownEventCommand}" Event="MouseDown" PassArguments="True" />
						<behaviors:EventToCommandBehavior Command="{Binding MouseUpEventCommand}" Event="MouseUp" PassArguments="True" />
					</i:Interaction.Behaviors>
					<Canvas.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                    </Canvas.RenderTransform>
                    <Border Visibility="{Binding GridVisibility}"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <VisualBrush TileMode="Tile"
                                         Viewport="0,0,8,8" ViewportUnits="Absolute" 
                                         Viewbox="0,0,8,8" ViewboxUnits="Absolute">
                                <VisualBrush.Visual>
                                    <Rectangle Stroke="Magenta" StrokeThickness="0.1" Height="100" Width="100"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                        <Canvas Width="{Binding CanvasWidth}" 
                                Height="{Binding CanvasHeight}" 
                                x:Name="canvasGrid"
                                Background="Transparent">
                        </Canvas>
                    </Border>
					<Image RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Width="{Binding CanvasWidth}" 
                           Height="{Binding CanvasHeight}" 
                           Source="{Binding MapImage}"
                           Name="imgMap"
                           AllowDrop="True"
                           Stretch="UniformToFill">
					</Image>
					<Rectangle
						x:Name="rectSelectedArea"
						Visibility="{Binding MouseSelectionActive}"
						Width="{Binding MouseSelectionWidth}"
						Height="{Binding MouseSelectionHeight}"
						Stroke="White"
						IsHitTestVisible="False"
						Canvas.Left="{Binding MouseSelectionOriginX}"
						Canvas.Top="{Binding MouseSelectionOriginY}"
						StrokeThickness="0.4"
						StrokeDashArray="2,1" />
					<Rectangle
						x:Name="rectSelectedTiles"
						Visibility="{Binding TilesSelectedActive}"
						Width="{Binding TilesSelectedWidth}"
						Height="{Binding TilesSelectedHeight}"
						Stroke="Red"
						IsHitTestVisible="False"
						Canvas.Left="{Binding TilesSelectedOriginX}"
						Canvas.Top="{Binding TilesSelectedOriginY}"
						StrokeThickness="0.4" />
                    <Image RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Name="cursorImage"
                           Visibility="Visible"
                           IsHitTestVisible="False"
                           Stretch="UniformToFill">
                    </Image>
                    <Image RenderOptions.BitmapScalingMode="NearestNeighbor"
						   Name="cursorMoveImage"
						   Visibility="Visible"
						   IsHitTestVisible="False"
						   Stretch="UniformToFill">	
                    </Image>
                </Canvas>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Column="2">
            <TabControl 
                DockPanel.Dock="Right"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
                <TabItem Header="Configuration">
                </TabItem>
				<TabItem Header="Bank" IsSelected="True">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="10"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="10"/>
						</Grid.ColumnDefinitions>
						<Grid Grid.Column="1">
							<Grid.RowDefinitions>
								<RowDefinition Height="5"/>
								<RowDefinition Height="auto"/>
								<RowDefinition Height="5"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>
							<StackPanel Orientation="Horizontal" Grid.Row="1">
								<ComboBox Width="200"
                                          ItemsSource="{Binding Banks}" 
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding Path=SelectedBank, Mode=TwoWay}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
							</StackPanel>
							<ScrollViewer
								VerticalAlignment="Top"
                                Grid.Row="3"
                                PanningMode="Both"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Visible">
								<local:BankViewerView
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
									IndividualSelection="True"
                                    AllowDrop="False"
                                    Force2DView="True"
                                    x:Name="bankViewer"/>
							</ScrollViewer>
						</Grid>
					</Grid>
				</TabItem>
				<TabItem Header="Tiles">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
							<RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
					    <GroupBox Header="Palettes" Grid.Row="0" Grid.Column="1">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
									<RowDefinition Height="auto"/>
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="22"/>
									<ColumnDefinition Width="auto"/>
									<ColumnDefinition Width="300"/>
								</Grid.ColumnDefinitions>
								<Label Content="0" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="0"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[0].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="0" PaletteIndex="0" Padding="5,0,0,5" x:Name="palette0" Grid.Column="2"/>
								<Label Content="1" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="1"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[1].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="1" PaletteIndex="1" Padding="5,0,0,5" x:Name="palette1" Grid.Column="2"/>
								<Label Content="2" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="2"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[2].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="2" PaletteIndex="2" Padding="5,0,0,5" x:Name="palette2" Grid.Column="2"/>
								<Label Content="3" Grid.Column="0" Grid.Row="3" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="3"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[3].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="3" PaletteIndex="3" Padding="5,0,0,5" x:Name="palette3" Grid.Column="2"/>
								<Label Content="4" Grid.Column="0" Grid.Row="4" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="4"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[4].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="4" PaletteIndex="4" Padding="5,0,0,5" x:Name="palette4" Grid.Column="2"/>
								<Label Content="5" Grid.Column="0" Grid.Row="5" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="5"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[5].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="5" PaletteIndex="5" Padding="5,0,0,5" x:Name="palette5" Grid.Column="2"/>
								<Label Content="6" Grid.Column="0" Grid.Row="6" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="6"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[6].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="6" PaletteIndex="6" Padding="5,0,0,5" x:Name="palette6" Grid.Column="2"/>
								<Label Content="7" Grid.Column="0" Grid.Row="7" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="7"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[7].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="7" PaletteIndex="7" Padding="5,0,0,5" x:Name="palette7" Grid.Column="2"/>
								<Label Content="8" Grid.Column="0" Grid.Row="8" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="8"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[8].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="8" PaletteIndex="8" Padding="5,0,0,5" x:Name="palette8" Grid.Column="2"/>
								<Label Content="9" Grid.Column="0" Grid.Row="9" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="9"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[9].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="9" PaletteIndex="9" Padding="5,0,0,5" x:Name="palette9" Grid.Column="2"/>
								<Label Content="10" Grid.Column="0" Grid.Row="10" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="10"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[10].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="10" PaletteIndex="10" Padding="5,0,0,5" x:Name="palette10" Grid.Column="2"/>
								<Label Content="11" Grid.Column="0" Grid.Row="11" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="11"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[11].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="11" PaletteIndex="11" Padding="5,0,0,5" x:Name="palette11" Grid.Column="2"/>
								<Label Content="12" Grid.Column="0" Grid.Row="12" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="12"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[12].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="12" PaletteIndex="12" Padding="5,0,0,5" x:Name="palette12" Grid.Column="2"/>
								<Label Content="13" Grid.Column="0" Grid.Row="13" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="13"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[13].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="13" PaletteIndex="13" Padding="5,0,0,5" x:Name="palette13" Grid.Column="2"/>
								<Label Content="14" Grid.Column="0" Grid.Row="14" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="14"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[14].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="14" PaletteIndex="14" Padding="5,0,0,5" x:Name="palette14" Grid.Column="2"/>
								<Label Content="15" Grid.Column="0" Grid.Row="15" HorizontalAlignment="Center"/>
								<ComboBox Width="150" Grid.Row="15"
                                          Margin="1"
										  Grid.Column="1"
                                          ItemsSource="{Binding Palettes}" 
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding PaletteIDs[15].Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
									<i:Interaction.Behaviors>
										<behaviors:EventToCommandBehavior Command="{Binding FileModelVOSelectionChangedCommand}" Event="SelectionChanged" PassArguments="True" />
									</i:Interaction.Behaviors>
								</ComboBox>
								<local:PaletteViewer Grid.Row="15" PaletteIndex="15" Padding="5,0,0,5" x:Name="palette15" Grid.Column="2"/>
							</Grid>
						</GroupBox>
						<GroupBox Header="Tile" 
								  Grid.Row="1" 
								  Grid.Column="1"
							      Padding="10">
							<GroupBox.Style>
								<Style>
									<Setter Property="Control.IsEnabled" Value="true" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding Path=SelectedTile}" Value="{x:Null}">
											<Setter Property="Control.IsEnabled" Value="false" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</GroupBox.Style>
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="auto" />
									<RowDefinition Height="5" />
									<RowDefinition Height="auto" />
								</Grid.RowDefinitions>
								<StackPanel Orientation="Horizontal" Grid.Row="0">
									<CheckBox IsChecked="{Binding SelectedTile.IsFlippedHorizontal, Mode=TwoWay}" HorizontalAlignment="Left">Flip Horizontal</CheckBox>
									<CheckBox IsChecked="{Binding SelectedTile.IsFlippedVertical, Mode=TwoWay}" HorizontalAlignment="Left" Margin="30,0,0,0">Flip Vertical</CheckBox>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Grid.Row="2">
									<Label>Palette index:</Label>
									<ComboBox HorizontalAlignment="Left" VerticalAlignment="Center" 
											  ItemsSource="{StaticResource PaletteIndices}"
											  SelectedValue="{Binding SelectedTile.PaletetteIndex, Mode=TwoWay}">
									</ComboBox>
								</StackPanel>
							</Grid>
						</GroupBox>
					</Grid>
                </TabItem>
                <TabItem Header="Entities">
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
